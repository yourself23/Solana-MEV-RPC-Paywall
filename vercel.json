{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/mcp/.well-known/glama.json", "destination": "/.well-known/glama.json" },
    { "source": "/api/arb/:feed", "destination": "/api/arb/index?feed=:feed" },
    { "source": "/api/mev/:action", "destination": "/api/mev/index?action=:action" },
    { "source": "/api/:path*", "destination": "/api/not-found" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
